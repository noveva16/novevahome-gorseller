    "nh_ozellik": {
      "type": "custom-liquid",
      "name": "İhtiyaca ve odaya göre",
      "settings": {
        "custom_liquid": "<style>\n  .nh-oz{max-width:1200px;margin:0 auto;padding:0 16px}\n  .nh-oz h2{text-align:center;margin:0 0 6px}\n  .nh-oz .nh-oz-alt{text-align:center;opacity:.75;margin:0 0 22px;font-size:1.5rem}\n  .nh-oz-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}\n  .nh-oz-kart{display:flex;flex-direction:column;gap:6px;border:1px solid rgba(0,0,0,.1);border-radius:14px;padding:18px;text-decoration:none;color:inherit;background:rgba(255,255,255,.6);transition:transform .15s,box-shadow .15s}\n  .nh-oz-kart:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,0,0,.08)}\n  .nh-oz-ikon{font-size:2.8rem;line-height:1}\n  .nh-oz-kart b{font-size:1.7rem}\n  .nh-oz-kart span{font-size:1.35rem;opacity:.8;line-height:1.5}\n  .nh-oz-kart em{font-style:normal;font-size:1.3rem;font-weight:600;margin-top:auto;padding-top:6px}\n  .nh-oda{margin-top:26px;text-align:center}\n  .nh-oda p{font-weight:600;margin:0 0 10px;font-size:1.5rem}\n  .nh-oda-liste{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}\n  .nh-oda-liste a{border:1px solid rgba(0,0,0,.18);border-radius:999px;padding:8px 16px;font-size:1.35rem;text-decoration:none;color:inherit}\n  .nh-oda-liste a:hover{border-color:currentColor}\n  @media (max-width:989px){.nh-oz-grid{grid-template-columns:repeat(2,1fr)}}\n  @media (max-width:480px){.nh-oz-kart{padding:14px}.nh-oz-kart b{font-size:1.5rem}}\n</style>\n<div class=\"nh-oz\" id=\"ihtiyaca-gore\">\n  <h2 class=\"h1\">İhtiyacına Göre Perdeni Seç</h2>\n  <p class=\"nh-oz-alt\">Ne istediğini biliyorsan doğru perdeye tek tıkla ulaş.</p>\n  <div class=\"nh-oz-grid\">\n    <a class=\"nh-oz-kart\" href=\"/products/plise-perde\">\n      <span class=\"nh-oz-ikon\" aria-hidden=\"true\">🔥</span>\n      <b>Isı Yalıtımı</b>\n      <span>Kışın sıcağı içeride tutan, yazın güneşi süzen katlanır plise perde. Cam balkonlar için ideal.</span>\n      <em>Plise Perde →</em>\n    </a>\n    <a class=\"nh-oz-kart\" href=\"/blogs/news/plise-perde-montaji-nasil-yapilir\">\n      <span class=\"nh-oz-ikon\" aria-hidden=\"true\">🔩</span>\n      <b>Delmeden Montaj</b>\n      <span>Kancalı ya da yapıştırmalı montajla cam balkon profilini delmeden takın.</span>\n      <em>Montaj Seçenekleri →</em>\n    </a>\n    <a class=\"nh-oz-kart\" href=\"/blogs/news/gece-gunduz-ciftli-plise-sistem\">\n      <span class=\"nh-oz-ikon\" aria-hidden=\"true\">🌗</span>\n      <b>Gece – Gündüz</b>\n      <span>Gündüz tül, gece perde. Çiftli plise sistemle tek perdede iki işlev.</span>\n      <em>Çiftli Sistem →</em>\n    </a>\n    <a class=\"nh-oz-kart\" href=\"/products/zebra-perde\">\n      <span class=\"nh-oz-ikon\" aria-hidden=\"true\">☀️</span>\n      <b>Işık Kontrolü</b>\n      <span>Şeritleri kaydırarak içeri giren ışığı dilediğiniz kadar ayarlayın.</span>\n      <em>Zebra Perde →</em>\n    </a>\n  </div>\n  <div class=\"nh-oda\">\n    <p>Odana göre öneriler</p>\n    <div class=\"nh-oda-liste\">\n      <a href=\"/blogs/news/cam-balkon-perdesi-plise-rehberi\">Cam Balkon</a>\n      <a href=\"/blogs/news/salon-perdesi-secimi-onerileri\">Salon</a>\n      <a href=\"/blogs/news/yatak-odasi-perdesi-karartma\">Yatak Odası</a>\n      <a href=\"/blogs/news/mutfak-perdesi-pratik-secenekler\">Mutfak</a>\n      <a href=\"/blogs/news/cocuk-odasi-perdesi-guvenli\">Çocuk Odası</a>\n      <a href=\"/blogs/news/ofis-perdesi-isik-kontrolu\">Ofis</a>\n      <a href=\"/blogs/news/kis-bahcesi-veranda-perdesi\">Kış Bahçesi</a>\n    </div>\n  </div>\n</div>\n",
        "color_scheme": "background-2",
        "padding_top": 40,
