{%- comment -%}
  Noveva Home — Ana sayfa "Perde Rehberi" blog kartları.
  Gösterilecek yazılar: aşağıdaki listeye blog/yazı-handle yazın.
{%- endcomment -%}
{%- capture nh_blog_liste -%}
news/cam-balkon-perde-olcusu-nasil-alinir
news/cam-balkon-plise-perde-fiyatlari-2026
news/blackout-plise-perde-fiyatlari-2026
{%- endcapture -%}
{%- assign nh_yazilar = nh_blog_liste | strip | newline_to_br | split: '<br />' -%}
<style>
  .nh-bl{max-width:1200px;margin:0 auto;padding:0 16px}
  .nh-bl-bas{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:0 0 18px}
  .nh-bl-bas h2{margin:0}
  .nh-bl-bas a{font-weight:600;text-decoration:underline;color:inherit;font-size:1.4rem}
  .nh-bl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .nh-bl-k{display:flex;flex-direction:column;border-radius:14px;overflow:hidden;background:#fff;border:1px solid rgba(0,0,0,.08);text-decoration:none;color:inherit}
  .nh-bl-img{aspect-ratio:16/10;background:#f2f2f0;overflow:hidden}
  .nh-bl-img img{width:100%;height:100%;object-fit:cover;display:block}
  .nh-bl-ic{padding:14px;display:flex;flex-direction:column;gap:6px;flex:1}
  .nh-bl-ic b{font-size:1.6rem;line-height:1.3}
  .nh-bl-ic p{margin:0;font-size:1.3rem;opacity:.75;line-height:1.5}
  .nh-bl-ic span{margin-top:auto;padding-top:6px;font-weight:600;font-size:1.3rem}
  @media (max-width:749px){.nh-bl-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 16px;margin:0 -16px;padding:0 16px 6px}.nh-bl-k{flex:0 0 78%;scroll-snap-align:start}}
</style>
<div class="nh-bl">
  <div class="nh-bl-bas">
    <h2 class="h1">Perde Rehberi</h2>
    <a href="/blogs/news">Tüm yazılar →</a>
  </div>
  <div class="nh-bl-grid">
    {%- for h in nh_yazilar -%}
      {%- assign y = articles[h] -%}
      {%- if y != blank and y.title != blank -%}
        <a class="nh-bl-k" href="{{ y.url }}">
          <div class="nh-bl-img">
            {%- if y.image -%}{{ y.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,500,700', sizes: '(max-width: 749px) 78vw, 33vw', alt: y.title }}{%- endif -%}
          </div>
          <div class="nh-bl-ic">
            <b>{{ y.title }}</b>
            <p>{{ y.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
            <span>Okumaya devam et →</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
