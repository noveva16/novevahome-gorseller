order_spacing_mobile":0,"swipe_on_mobile":false,"padding_top":60,"padding_bottom":60},"disabled":true},"testimonials_UFzMP8":{"type":"testimonials","blocks":{"quote_3KxWnG":{"type":"quote","settings":{"title":"Perdeler tam istediğim gibi, hem kaliteli hem şık. Hızlı kargo güzel paketleme herşey için teşekkürler","content":"","number_of_stars":5,"user_full_name":"Aslıhan C.","hide_avatar":false,"user_title":""}},"quote_d83DyM":{"type":"quote","settings":{"title":"Siparişim hızlı geldi, paketleme mükemmeldi","content":"","number_of_stars":5,"user_full_name":"Neslihan Ö.","hide_avatar":false,"user_title":""}},"quote_NFqCy4":{"type":"quote","settings":{"title":"Evimdeki dekorasyonun havası değişti, teşekkürler!","content":"","number_of_stars":5,"user_full_name":"Sibel D.","hide_avatar":false,"user_title":""}},"quote_jNCgTU":{"type":"quote","settings":{"title":"Salonuma çok yakıştı, herkese tavsiye ederim.","content":"","number_of_stars":5,"user_full_name":"Burak Y.","hide_avatar":false,"user_title":""}},"quote_mBzt3F":{"type":"quote","settings":{"title":"paketleme çok özenliydi. perde çok kaliteli ve gayet kalın teşekkürler çok memnun kaldım","content":"<p><br/><br/></p>","number_of_stars":5,"user_full_name":"H** A**","hide_avatar":false,"user_title":""}},"quote_BrjhbL":{"type":"quote","settings":{"title":"Harika bir stor hem kalite hemde ebatları istediğim gibi geldi. Kargo hızlıydı satıcıya teşekkür ederim kaliteli ve sorunsuz ürün gönderdiği için tavsiye ederim.","content":"","number_of_stars":5,"user_full_name":"Saliha T.","hide_avatar":false,"user_title":""}},"quote_6EenzF":{"type":"quote","settings":{"title":"çok beğendim harika","content":"","number_of_stars":5,"user_full_name":"Senda A.","hide_avatar":false,"user_title":""}}},"block_order":["quote_3KxWnG","quote_d83DyM","quote_NFqCy4","quote_jNCgTU","quote_mBzt3F","quote_BrjhbL","quote_6EenzF"],"name":"Yorumlar","settings":{"title":"Sizden Gelen Güzel Yorumlar","subtitle":"","heading_size":"h1","auto_rotate":false,"change_slides_speed":5,"enable_section_box_layout":false,"color_scheme":"background-2","padding_top":80,"padding_bottom":0}},"8f5a111c-95e5-4fe4-9470-893b0e7841d7":{"type":"collapsible-content","blocks":{"template--20124663021869__8f5a111c-95e5-4fe4-9470-893b0e7841d7-collapsible_row-1":{"type":"collapsible_row","settings":{"heading":"Kargo ve Teslimat Bilgisi","icon":"truck","row_content":"<p>Tüm perdelerimiz <strong>sizin ölçünüze özel olarak üretilir</strong>.</p><p><strong>Üretim:</strong> 2–4 iş günü<br/><strong>Kargo:</strong> 1–3 iş günü<br/><strong>Kargo ücreti:</strong> Türkiye geneli ücretsiz</p><p>Perdeleriniz korumalı ambalajla, montaj aparatlarıyla birlikte gönderilir.</p><p>Ayrıntılar için <a href=\"/policies/shipping-policy\">Kargo Politikası</a>.</p>","page":""}},"template--20124663021869__8f5a111c-95e5-4fe4-9470-893b0e7841d7-collapsible_row-3":{"type":"collapsible_row","settings":{"heading":"Ölçü Alma Rehberi","icon":"arrows_expand","row_content":"<p>Tüm ölçülerimiz <strong>EN × BOY</strong> (cm) formatındadır.</p><p><strong>EN:</strong> Perdenin genişliği. Cam balkon ve pencere içine montajda kasa içi ölçüyü alın; kasa dışına montajda her iki yandan 5–10 cm pay ekleyin.<br/><strong>BOY:</strong> Perdenin yüksekliği.</p><p>Adım adım anlatım için <a href=\"/pages/olcu-nasil-alinir\">Ölçü Nasıl Alınır?</a> sayfamıza göz atın. Emin olamazsanız WhatsApp'tan yazın, birlikte kontrol edelim.</p>","page":""}},"ba6c83bd-c48c-41e2-8afc-c4173cbd13e0":{"type":"collapsible_row","settings":{"heading":"Temizlik & Bakım Önerileri","icon":"appliances","row_content":"<p><strong>Temizlik:</strong> Perdenizi kuru ve yumuşak bir fırça ya da tüy alıcıyla düzenli olarak tozdan arındırın. Leke olursa ılık su ve az miktarda elde yıkama deterjanıyla nemlendirilmiş yumuşak bir bezle hafifçe silin.</p><p>Çamaşır suyu, ağır kimyasallar ve sert süngerler kullanmayın. Plise, stor ve zebra perdeleri makinede yıkamayın; sildikten sonra açık konumda kurumaya bırakın.</p><p>Perde türüne göre ayrıntılı öneriler: <a href=\"/blogs/news/plise-perde-temizligi-bakimi\">Plise perde bakımı</a>, <a href=\"/blogs/news/zebra-perde-temizligi\">Zebra perde temizliği</a>, <a href=\"/blogs/news/ahsap-jaluzi-bakimi-temizligi\">Ahşap jaluzi bakımı</a>.</p>","page":""}},"f720c224-680e-4598-aa51-f0d9c079f489":{"type":"collapsible_row","settings":{"heading":"Montaj Talimatları","icon":"shield_exclamation","row_content":"<p>Ürünlerimizle birlikte <strong>montaj aparatları iki farklı şekilde</strong> gönderilmektedir:</p><ol><li><strong>Plastik ayaklar</strong>: Kornaş veya plastik raylı sistemlere kolayca takılabilir.<br/></li><li><strong>Metal ayaklar</strong>: Duvara veya tavana monte edilebilir, ekstra sağlamlık sağlar.<br/></li></ol><p>Böylece, perdenizi <strong>ihtiyacınıza ve mekanınıza uygun şekilde</strong> rahatça monte edebilirsiniz.</p><p>Adım adım anlatım için <a href=\"/blogs/news/plise-perde-montaji-nasil-yapilir\">Plise Perde Montajı Nasıl Yapılır?</a> rehberimize göz atın.</p>","page":""}},"4cfd744b-0b74-49a5-9769-1546d3204450":{"type":"collapsible_row","settings":{"heading":"İade & Değişim","icon":"support","row_content":"<p>Perdelerimiz <strong>sizin verdiğiniz ölçülere göre kişiye özel üretildiği</strong> için Mesafeli Sözleşmeler Yönetmeliği md. 15 gereği cayma hakkı kapsamı dışındadır.</p><p><strong>Üretime başlanmadan</strong> önce siparişinizi iptal edebilir veya ölçünüzü değiştirebilirsiniz.</p><p>Ürün size <strong>hasarlı ya da üretim hatalı</strong> ulaşırsa, teslimattan itibaren 14 gün içinde bize bildirin; ücretsiz olarak yeniden üretip gönderiyoruz.</p><p>Detaylar için <a href=\"/policies/refund-policy\">İade Politikası</a>.</p>","page":""}}},"block_order":["template--20124663021869__8f5a111c-95e5-4fe4-9470-893b0e7841d7-collapsible_row-1","template--20124663021869__8f5a111c-95e5-4fe4-9470-893b0e7841d7-collapsible_row-3","ba6c83bd-c48c-41e2-8afc-c4173cbd13e0","f720c224-680e-4598-aa51-f0d9c079f489","4cfd744b-0b74-49a5-9769-1546d3204450"],"settings":{"section_width":"grid","title":"Bilgilendirme","subtitle":"","heading_size":"h1","enable_section_box_layout":false,"color_scheme":"background-2","open_first_collapsible_row":false,"open_all_collapsible_row":false,"hide_image_on_mobile":false,"image_ratio":"adapt","desktop_layout":"image_second","padding_top":36,"padding_bottom":36}},"nh_ozellik":{"type":"custom-liquid","name":"İhtiyaca ve odaya göre","settings":{"custom_liquid":"<style>\n  .nh-oz{max-width:1200px;margin:0 auto;padding:0 16px}\n  .nh-oz h2{text-align:center;margin:0 0 6px}\n  .nh-oz .nh-oz-alt{text-align:center;opacity:.75;margin:0 0 22px;font-size:1.5rem}\n  .nh-oz-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}\n  .nh-oz-kart{display:flex;flex-direction:column;gap:6px;border:1px solid rgba(0,0,0,.1);border-radius:14px;padding:18px;text-decoration:none;color:inherit;background:rgba(255,255,255,.6);transition:transform .15s,box-shadow .15s}\n  .nh-oz-kart:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,0,0,.08)}\n  .nh-oz-ikon{font-size:2.8rem;line-height:1}\n  .nh-oz-kart b{font-size:1.7rem}\n  .nh-oz-kart span{font-size:1.35rem;opacity:.8;line-height:1.5}\n  .nh-oz-kart em{font-style:normal;font-size:1.3rem;font-weight:600;margin-top:auto;padding-top:6px}\n  .nh-oda{margin-top:26px;text-align:center}\n  .nh-oda p{font-weight:600;margin:0 0 10px;font-size:1.5rem}\n  .nh-oda-liste{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}\n  .nh-oda-liste a{border:1px solid rgba(0,0,0,.18);border-radius:999px;padding:8px 16px;font-size:1.35rem;text-decoration:none;color:inherit}\n  .nh-oda-liste a:hover{border-color:currentColor}\n  @media (max-width:989px){.nh-oz-grid{grid-template-columns:repeat(2,1fr)}}\n  @media (max-width:480px){.nh-oz-kart{padding:14px}.nh-oz-kart b{font-size:1.5rem}}\n</style>\n<div class=\"nh-oz\" id=\"ihtiyaca-gore\">\n  <h2 class=\"h1\">İhtiyacına Göre Perdeni Seç</h2>\n  <p class=\"nh-oz-alt\">Ne istediğini biliyorsan doğru perdeye tek tıkla ulaş.</p>\n  <div class=\"nh-oz-grid\">\n    <a class=\"nh-oz-kart\" href=\"/products/plise-perde\">\n      <span class=\"nh-oz-ikon\" aria-hidden=\"true\">🔥</span>\n      <b>Isı Yalıtımı</b>\n      <span>Kışın sıcağı içeride tutan, yazın güneşi süzen katlanır plise perde. Cam balkonlar için ideal.</span>\n      <em>Plise Perde →</em>\n    </a>\n    <a class=\"nh-oz-kart\" href=\"/blogs/news/plise-perde-montaji-nasil-yapilir\">\n      <span class=\"nh-oz-ikon\" aria-hidden=\"true\">🔩</span>\n      <b>Delmeden Montaj</b>\n      <span>Kancalı ya da yapıştırmalı montajla cam balkon profilini delmeden takın.</span>\n      <em>Montaj Seçenekleri →</em>\n    </a>\n    <a class=\"nh-oz-kart\" href=\"/blogs/news/gece-gunduz-ciftli-plise-sistem\">\n      <span class=\"nh-oz-ikon\" aria-hidden=\"true\">🌗</span>\n      <b>Gece – Gündüz</b>\n      <span>Gündüz tül, gece perde. Çiftli plise sistemle tek perdede iki işlev.</span>\n      <em>Çiftli Sistem →</em>\n    </a>\n    <a class=\"nh-oz-kart\" href=\"/products/zebra-perde\">\n      <span class=\"nh-oz-ikon\" aria-hidden=\"true\">☀️</span>\n      <b>Işık Kontrolü</b>\n      <span>Şeritleri kaydırarak içeri giren ışığı dilediğiniz kadar ayarlayın.</span>\n      <em>Zebra Perde →</em>\n    </a>\n  </div>\n  <div class=\"nh-oda\">\n    <p>Odana göre öneriler</p>\n    <div class=\"nh-oda-liste\">\n      <a href=\"/blogs/news/cam-balkon-perdesi-plise-rehberi\">Cam Balkon</a>\n      <a href=\"/blogs/news/salon-perdesi-secimi-onerileri\">Salon</a>\n      <a href=\"/blogs/news/yatak-odasi-perdesi-karartma\">Yatak Odası</a>\n      <a href=\"/blogs/news/mutfak-perdesi-pratik-secenekler\">Mutfak</a>\n      <a href=\"/blogs/news/cocuk-odasi-perdesi-guvenli\">Çocuk Odası</a>\n      <a href=\"/blogs/news/ofis-perdesi-isik-kontrolu\">Ofis</a>\n      <a href=\"/blogs/news/kis-bahcesi-veranda-perdesi\">Kış Bahçesi</a>\n    </div>\n  </div>\n</div>\n","color_scheme":"background-2","padding_top":40,"padding_bottom":40}},"nh_seo_yazi":{"type":"custom-liquid","name":"Neden Noveva Home (SEO yazısı)","settings":{"custom_liquid":"<style>\n  .nh-seo{max-width:900px;margin:0 auto;padding:0 16px;font-size:1.45rem;line-height:1.7}\n  .nh-seo h2{font-size:2.2rem;margin:0 0 12px}\n  .nh-seo h3{font-size:1.7rem;margin:20px 0 6px}\n  .nh-seo p{margin:0 0 10px;opacity:.88}\n  .nh-seo a{text-decoration:underline}\n  .nh-seo details summary{cursor:pointer;font-weight:600;margin:6px 0 4px;list-style:none}\n  .nh-seo details summary::-webkit-details-marker{display:none}\n  .nh-seo details[open] summary{display:none}\n</style>\n<div class=\"nh-seo\" id=\"neden-noveva-home\">\n  <h2>Ölçüye Özel Perde: Neden Noveva Home?</h2>\n  <p>Noveva Home, cam balkon ve pencereler için <strong>ölçüye özel plise, zebra, stor ve ahşap jaluzi perde</strong> üretir. Sitemizde ölçünüzü girdiğiniz anda perdenizin fiyatını görür, tek tıkla sipariş verirsiniz. Perdeniz 2–4 iş gününde üretilir ve Türkiye'nin her yerine ücretsiz kargoyla gönderilir.</p>\n  <details>\n    <summary>Devamını oku ↓</summary>\n    <h3>Hangi perde size uygun?</h3>\n    <p><a href=\"/products/plise-perde\">Plise perde</a> katlanarak açılır, az yer kaplar ve ısı yalıtımı sağlar; bu yüzden cam balkonların en çok tercih edilen perdesidir. <a href=\"/products/zebra-perde\">Zebra perde</a>, şeritlerini kaydırarak ışığı kademeli ayarlamanızı sağlar; salon ve oturma odaları için modern bir seçimdir. <a href=\"/products/stor-perde\">Stor perde</a> sade ve uygun fiyatlıdır; mutfak, çalışma odası ve ofisler için pratiktir. <a href=\"/products/ahsap-jaluzi-perde\">Ahşap jaluzi</a> ise doğal dokusuyla sıcak bir görünüm isteyenler içindir. Kararsız kalırsanız <a href=\"/blogs/news/plise-mi-zebra-mi-hangi-perde\">Plise mi Zebra mı?</a> yazımıza göz atın.</p>\n    <h3>Ölçü nasıl alınır?</h3>\n    <p>Ölçüler santimetre olarak EN × BOY şeklinde girilir. Cam balkonda her kanadı ayrı ölçün; açılan ilk kanadı ve köşede birleşen iki camdan birini 2 cm eksik yazın. Adım adım anlatım için <a href=\"/pages/olcu-nasil-alinir\">Ölçü Nasıl Alınır?</a> sayfamıza ve <a href=\"/blogs/news/cam-balkon-perde-olcusu-nasil-alinir\">cam balkon ölçü rehberimize</a> bakabilirsiniz. Emin olamazsanız WhatsApp'tan yazın, ölçünüzü birlikte kontrol edelim.</p>\n    <h3>Perde fiyatları nasıl hesaplanır?</h3>\n    <p>Tüm perdelerimiz metrekare üzerinden fiyatlandırılır; ölçünüzü girdiğiniz anda fiyat hesaplanır, gizli ücret yoktur. Perde, mekanizma ve montaj aparatları fiyata dahildir. Ayrıntılı örnekler için <a href=\"/blogs/news/cam-balkon-plise-perde-fiyatlari-2026\">Cam Balkon Plise Perde Fiyatları 2026</a> ve <a href=\"/blogs/news/zebra-stor-perde-fiyatlari-2026\">Zebra ve Stor Perde Fiyatları 2026</a> yazılarımızı okuyabilirsiniz.</p>\n    <h3>Montaj ve bakım</h3>\n    <p>Perdeleriniz montaj aparatlarıyla birlikte gelir; kancalı, vidalı veya yapıştırmalı montajla kolayca takılır. Montaj seçeneklerini <a href=\"/blogs/news/plise-perde-montaji-nasil-yapilir\">plise perde montaj rehberimizde</a>, temizlik önerilerini <a href=\"/blogs/news/plise-perde-temizligi-bakimi\">plise perde bakım yazımızda</a> bulabilirsiniz. Daha fazlası için <a href=\"/blogs/news\">Perde Rehberi</a>'ne göz atın.</p>\n  </details>\n</div>\n","color_scheme":"background-2","padding_top":24,"padding_bottom":48}},"nh_uygulamalar":{"type":"custom-liquid","name":"Gerçek Uygulamalar","settings":{"custom_liquid":"{% render 'nh-uygulamalar' %}","color_scheme":"background-2","padding_top":48,"padding_bottom":48}},"nh_seriler":{"type":"custom-liquid","name":"Plise Perde Serileri","settings":{"custom_liquid":"{% render 'nh-seriler' %}","color_scheme":"background-2","padding_top":40,"padding_bottom":40}},"nh_guven":{"type":"custom-liquid","name":"Güven şeridi","settings":{"custom_liquid":"{% render 'nh-guven' %}","color_scheme":"background-2","padding_top":16,"padding_bottom":8}},"nh_urunler":{"type":"custom-liquid","name":"Perdeni Seç – ürün kartları","settings":{"custom_liquid":"{% render 'nh-